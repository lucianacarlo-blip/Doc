const allBorders = { top: thinBorder, bottom: thinBorder, left: thinBorder, right: thinBorder };
const headerShade = { fill: 'D9E2F3', type: ShadingType.CLEAR };

function tableRow(cells, isHeader = false) {
  return new TableRow({
    tableHeader: isHeader,
    children: cells.map((txt, i) => new TableCell({
      borders: allBorders,
      shading: isHeader ? headerShade : { fill: 'FFFFFF', type: ShadingType.CLEAR },
      margins: { top: 80, bottom: 80, left: 140, right: 140 },
      width: { size: i === 0 ? 3200 : 3080, type: WidthType.DXA },
      verticalAlign: VerticalAlign.CENTER,
      children: [new Paragraph({
        alignment: AlignmentType.LEFT,
        spacing: { after: 0 },
        children: [new TextRun({ text: txt, size: 22, font: 'Arial', bold: isHeader })],
      })],
    })),
  });
}

function buildTable(headers, rows) {
  const colWidths = [3200, 3080, 3080];
  return new Table({
    width: { size: 9360, type: WidthType.DXA },
    columnWidths: colWidths.slice(0, headers.length),
    rows: [
      tableRow(headers, true),
      ...rows.map(r => tableRow(r, false)),
    ],
  });
}

function pageBreak() {
  return new Paragraph({ children: [new PageBreak()], spacing: { after: 0 } });
}

function emptyLine() {
  return new Paragraph({ children: [new TextRun('')], spacing: { after: 0 } });
}

function footerNote(text) {
  return new Paragraph({
    spacing: { before: 80, after: 80 },
    children: splitBold(text).map(r => new TextRun({ ...r, size: 18, font: 'Arial', italics: true })),
  });
}

