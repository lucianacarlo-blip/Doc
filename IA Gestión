// Build a paragraph that mixes bold "creatividad" with normal text.
// Pass an array of {text, bold?, italic?, size?} or a plain string.
function p(runs, opts = {}) {
  const children = [];
  if (typeof runs === 'string') {
    // auto-bold every "creatividad" occurrence
    runs = splitBold(runs);
  }
  for (const r of runs) {
    children.push(new TextRun({
      text: r.text,
      bold: r.bold || false,
      italics: r.italic || false,
      size: r.size || 24,
      font: 'Arial',
    }));
  }
  return new Paragraph({
    children,
    spacing: { after: 160, line: 360 },
    alignment: opts.align || AlignmentType.JUSTIFIED,
    heading: opts.heading || undefined,
    indent: opts.indent,
  });
}

// Split a string so every occurrence of "creatividad" gets a bold run
function splitBold(str) {
  const keyword = /creatividad/gi;
  const result = [];
  let lastIdx = 0;
  let match;
  while ((match = keyword.exec(str)) !== null) {
    if (match.index > lastIdx) {
      result.push({ text: str.slice(lastIdx, match.index) });
    }
    result.push({ text: match[0], bold: true });
    lastIdx = match.index + match[0].length;
  }
  if (lastIdx < str.length) result.push({ text: str.slice(lastIdx) });
  return result.length ? result : [{ text: str }];
}

function heading1(text) {
  return new Paragraph({
    heading: HeadingLevel.HEADING_1,
    spacing: { before: 320, after: 160 },
    children: [new TextRun({ text, bold: true, size: 28, font: 'Arial', allCaps: false })],
  });
}

function heading2(text) {
  return new Paragraph({
    heading: HeadingLevel.HEADING_2,
    spacing: { before: 240, after: 120 },
    children: [new TextRun({ text, bold: true, size: 26, font: 'Arial', italics: true })],
  });
}

function bullet(str, level = 0) {
  return new Paragraph({
    numbering: { reference: 'bullets', level },
    spacing: { after: 100, line: 360 },
    children: splitBold(str).map(r => new TextRun({ ...r, size: 24, font: 'Arial' })),
  });
}

